{
  "prHourlyLimit": 0,
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",

  "enabledManagers": [
    "mise",
    "github-actions",
    "custom.regex",
    "gomod"
  ],

  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "^\\.github/workflows/.*ya?ml$"
        ],
      "matchStrings": [
        "MISE_VERSION:\\s*(?<currentValue>\\d{4}\\.\\d{2}\\.\\d{2})"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "jdx/mise",
      "versioningTemplate": "regex:^(?<major>\\d{4})\\.(?<minor>\\d{2})\\.(?<patch>\\d{2})$"
    }
  ],
  "packageRules": [
    {
      "description": "No cooldown for lablabs-owned packages",
      "matchPackageNames": [
        "lablabs/**",
        "ghcr.io/lablabs/**"
      ],
      "minimumReleaseAge": "0 days"
    }
  ],
  "vulnerabilityAlerts": {
    "addLabels": ["security"]
  }
}
